{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/jawa-dam/GEI-Research/blob/main/schema/text.schema.json","title":"GEI Text Record","type":"object","additionalProperties":false,"required":["id","type","title","status","version"],"properties":{"id":{"type":"string","pattern":"^TXT-[A-Z0-9-]+$"},"type":{"const":"text"},"title":{"type":"string","minLength":1},"status":{"type":"string","enum":["draft","active","deprecated"]},"version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},"tradition":{"type":"string"},"language":{"type":"string"},"date_range":{"type":"string"},"description":{"type":"string"},"civilization_ids":{"type":"array","items":{"type":"string","pattern":"^CIV-[A-Z0-9-]+$"}},"region_ids":{"type":"array","items":{"type":"string","pattern":"^REG-[A-Z0-9-]+$"}},"passage_ids":{"type":"array","items":{"type":"string","pattern":"^PAS-[A-Z0-9-]+$"}},"source_ids":{"type":"array","items":{"type":"string","pattern":"^SRC-[A-Z0-9-]+$"}},"notes":{"type":"string"}}}