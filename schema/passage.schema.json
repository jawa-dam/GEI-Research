{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/jawa-dam/GEI-Research/blob/main/schema/passage.schema.json","title":"GEI Passage Record","type":"object","additionalProperties":false,"required":["id","type","title","status","version","text_id","locator"],"properties":{"id":{"type":"string","pattern":"^PAS-[A-Z0-9-]+$"},"type":{"const":"passage"},"title":{"type":"string","minLength":1},"status":{"type":"string","enum":["draft","active","deprecated"]},"version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},"text_id":{"type":"string","pattern":"^TXT-[A-Z0-9-]+$"},"locator":{"type":"string","minLength":1},"quotation":{"type":"string"},"language":{"type":"string"},"translation":{"type":["string","null"]},"source_ids":{"type":"array","items":{"type":"string","pattern":"^SRC-[A-Z0-9-]+$"}},"observation_ids":{"type":"array","items":{"type":"string","pattern":"^EVD-[A-Z0-9-]+$"}},"notes":{"type":"string"}}}