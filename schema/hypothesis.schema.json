{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/jawa-dam/GEI-Research/blob/main/schema/hypothesis.schema.json","title":"GEI Hypothesis Record","type":"object","additionalProperties":false,"required":["id","type","title","status","version","hypothesis","test_status","confidence"],"properties":{"id":{"type":"string","pattern":"^HYP-[A-Z0-9-]+$"},"type":{"const":"hypothesis"},"title":{"type":"string","minLength":1},"status":{"type":"string","enum":["draft","active","deprecated"]},"version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},"hypothesis":{"type":"string","minLength":1},"rationale":{"type":"string"},"interpretation_ids":{"type":"array","items":{"type":"string","pattern":"^INT-[A-Z0-9-]+$"}},"evidence_ids":{"type":"array","items":{"type":"string","pattern":"^EVD-[A-Z0-9-]+$"}},"test_status":{"type":"string","enum":["untested","in_progress","supported","challenged","rejected","inconclusive"]},"confidence":{"type":"string","enum":["C0","C1","C2","C3","C4","C5"]},"predictions":{"type":"array","items":{"type":"string"}},"test_methods":{"type":"array","items":{"type":"string"}},"result_ids":{"type":"array","items":{"type":"string","pattern":"^RES-[A-Z0-9-]+$"}},"alternative_hypotheses":{"type":"array","items":{"type":"string"}},"counterevidence_ids":{"type":"array","items":{"type":"string","pattern":"^EVD-[A-Z0-9-]+$"}},"notes":{"type":"string"}}}