{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/jawa-dam/GEI-Research/blob/main/schema/record.schema.json","title":"GEI Base Research Record","description":"Common envelope for canonical GEI research records. Domain schemas add type-specific fields.","type":"object","additionalProperties":false,"required":["id","type","title","status","version"],"properties":{"id":{"type":"string","pattern":"^[A-Z]{3}-[A-Z0-9-]+$"},"type":{"type":"string","minLength":1},"title":{"type":"string","minLength":1},"status":{"type":"string","enum":["draft","active","deprecated"]},"version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},"created":{"type":"string"},"updated":{"type":"string"},"description":{"type":"string"},"source_ids":{"type":"array","items":{"type":"string","pattern":"^SRC-[A-Z0-9-]+$"}},"evidence_ids":{"type":"array","items":{"type":"string","pattern":"^EVD-[A-Z0-9-]+$"}},"notes":{"type":"string"}}}