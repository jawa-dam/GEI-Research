{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/jawa-dam/GEI-Research/blob/main/schema/evaluation.schema.json",
  "title":"GEI Research Outcome Evaluation Record",
  "type":"object",
  "additionalProperties":false,
  "required":["id","type","title","status","version","evaluation_status","outcome_ids","assessment"],
  "properties":{
    "id":{"type":"string","pattern":"^EVA-[A-Z0-9-]+-[0-9]{3}$"},
    "type":{"const":"evaluation"},
    "title":{"type":"string","minLength":1},
    "status":{"type":"string","enum":["draft","active","deprecated","final"]},
    "version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
    "evaluation_status":{"type":"string","enum":["planned","in_progress","complete","revised"]},
    "outcome_ids":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^OUT-[A-Z0-9-]+-[0-9]{3}$"}},
    "result_ids":{"type":"array","items":{"type":"string","pattern":"^RES-[A-Z0-9-]+-[0-9]{3}$"}},
    "hypothesis_ids":{"type":"array","items":{"type":"string","pattern":"^HYP-[A-Z0-9-]+-[0-9]{3}$"}},
    "provenance_ids":{"type":"array","items":{"type":"string","pattern":"^PRV-[A-Z0-9-]+-[0-9]{3}$"}},
    "assessment":{"type":"string","minLength":1},
    "expected_state":{"type":"string"},
    "observed_state":{"type":"string"},
    "delta":{"type":"string"},
    "disposition":{"type":"string","enum":["supports","partially_supports","challenges","inconclusive","requires_revision"]},
    "confidence":{"type":"string","enum":["C0","C1","C2","C3","C4","C5"]},
    "revision_recommendation":{"type":"string"},
    "notes":{"type":"string"}
  }
}
