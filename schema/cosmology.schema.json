{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/jawa-dam/GEI-Research/blob/main/schema/cosmology.schema.json","title":"GEI Cosmology Record","type":"object","additionalProperties":false,"required":["id","type","title","status","version"],"properties":{"id":{"type":"string","pattern":"^COS-[A-Z0-9-]+$"},"type":{"const":"cosmology"},"title":{"type":"string","minLength":1},"status":{"type":"string","enum":["draft","active","deprecated"]},"version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},"description":{"type":"string"},"tradition":{"type":"string"},"text_ids":{"type":"array","items":{"type":"string","pattern":"^TXT-[A-Z0-9-]+$"}},"civilization_ids":{"type":"array","items":{"type":"string","pattern":"^CIV-[A-Z0-9-]+$"}},"region_ids":{"type":"array","items":{"type":"string","pattern":"^REG-[A-Z0-9-]+$"}},"element_type":{"type":"string"},"source_ids":{"type":"array","items":{"type":"string","pattern":"^SRC-[A-Z0-9-]+$"}},"evidence_ids":{"type":"array","items":{"type":"string","pattern":"^EVD-[A-Z0-9-]+$"}},"notes":{"type":"string"}}}