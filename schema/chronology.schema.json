{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/jawa-dam/GEI-Research/blob/main/schema/chronology.schema.json","title":"GEI Chronology Record","type":"object","additionalProperties":false,"required":["id","type","title","status","version","start","end"],"properties":{"id":{"type":"string","pattern":"^CHR-[A-Z0-9-]+$"},"type":{"const":"chronology"},"title":{"type":"string","minLength":1},"status":{"type":"string","enum":["draft","active","deprecated"]},"version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},"start":{"type":"string"},"end":{"type":"string"},"description":{"type":"string"},"date_precision":{"type":"string","enum":["exact","year","range","century","millennium","broad","unknown"]},"date_system":{"type":"string"},"parent_id":{"type":["string","null"],"pattern":"^CHR-[A-Z0-9-]+$"},"region_ids":{"type":"array","items":{"type":"string","pattern":"^REG-[A-Z0-9-]+$"}},"civilization_ids":{"type":"array","items":{"type":"string","pattern":"^CIV-[A-Z0-9-]+$"}},"source_ids":{"type":"array","items":{"type":"string","pattern":"^SRC-[A-Z0-9-]+$"}},"notes":{"type":"string"}}}