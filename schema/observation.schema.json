{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/jawa-dam/GEI-Research/blob/main/schema/observation.schema.json","title":"GEI Research Observation Record","type":"object","additionalProperties":false,"required":["id","type","title","status","version","observation_status","execution_ids","observation"],"properties":{"id":{"type":"string","pattern":"^OBS-[A-Z0-9-]+-[0-9]{3}$"},"type":{"const":"observation"},"title":{"type":"string","minLength":1},"status":{"type":"string","enum":["draft","active","deprecated","closed"]},"version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},"observation_status":{"type":"string","enum":["recorded","verified","disputed","rejected"]},"execution_ids":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^EXE-[A-Z0-9-]+-[0-9]{3}$"}},"observation":{"type":"string","minLength":1},"measurement":{"type":"string"},"source_ids":{"type":"array","items":{"type":"string","pattern":"^SRC-[A-Z0-9-]+-[0-9]{3}$"}},"evidence_ids":{"type":"array","items":{"type":"string","pattern":"^EVD-[A-Z0-9-]+-[0-9]{3}$"}},"anomalies":{"type":"array","items":{"type":"string"}},"notes":{"type":"string"}}}