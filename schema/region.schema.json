{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/jawa-dam/GEI-Research/blob/main/schema/region.schema.json","title":"GEI Region Record","type":"object","additionalProperties":false,"required":["id","type","title","status","version"],"properties":{"id":{"type":"string","pattern":"^REG-[A-Z0-9-]+$"},"type":{"const":"region"},"title":{"type":"string","minLength":1},"status":{"type":"string","enum":["draft","active","deprecated"]},"version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},"description":{"type":"string"},"geographic_scope":{"type":"string"},"latitude_range":{"type":["string","null"]},"longitude_range":{"type":["string","null"]},"parent_region_id":{"type":["string","null"]},"civilization_ids":{"type":"array","items":{"type":"string","pattern":"^CIV-[A-Z0-9-]+$"}},"source_ids":{"type":"array","items":{"type":"string","pattern":"^SRC-[A-Z0-9-]+$"}},"notes":{"type":"string"}}}