{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/jawa-dam/GEI-Research/blob/main/schema/schema-common.json","title":"GEI Common Schema Definitions","$defs":{"status":{"type":"string","enum":["draft","active","deprecated"]},"version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},"confidence":{"type":"string","enum":["C0","C1","C2","C3","C4","C5"]},"sourceId":{"type":"string","pattern":"^SRC-[A-Z0-9-]+$"},"passageId":{"type":"string","pattern":"^PAS-[A-Z0-9-]+$"},"evidenceId":{"type":"string","pattern":"^EVD-[A-Z0-9-]+$"},"comparisonId":{"type":"string","pattern":"^CMP-[A-Z0-9-]+$"},"interpretationId":{"type":"string","pattern":"^INT-[A-Z0-9-]+$"},"hypothesisId":{"type":"string","pattern":"^HYP-[A-Z0-9-]+$"}}}