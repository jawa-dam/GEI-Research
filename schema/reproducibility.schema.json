{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/jawa-dam/GEI-Research/blob/main/schema/reproducibility.schema.json",
  "title":"GEI Research Reproducibility Record",
  "type":"object","additionalProperties":false,
  "required":["id","type","title","status","version","protocol_ids","execution_ids","reproduction_runs","assessment","reproducibility_status","epistemic_firewall"],
  "properties":{
    "id":{"type":"string","pattern":"^REP-[A-Z0-9-]+-[0-9]{3}$"},"type":{"const":"reproducibility"},"title":{"type":"string","minLength":1},"status":{"type":"string","enum":["draft","active","deprecated"]},"version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
    "protocol_ids":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^PRO-[A-Z0-9-]+-[0-9]{3}$"}},"execution_ids":{"type":"array","items":{"type":"string","pattern":"^[A-Z]{3}(?:-[A-Z0-9]+)+-[0-9]{3}$"}},
    "reproduction_runs":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["run_id","operator","protocol_version","status","step_results"],"properties":{"run_id":{"type":"string","pattern":"^RUN-[A-Z0-9-]+-[0-9]{3}$"},"operator":{"type":"string"},"protocol_version":{"type":"string"},"status":{"type":"string","enum":["planned","executed","failed","completed","inconclusive"]},"step_results":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["step_id","status","observed"],"properties":{"step_id":{"type":"string"},"status":{"type":"string","enum":["pass","fail","not_run"]},"observed":{"type":"string"},"deviation":{"type":"string"},"evidence_ids":{"type":"array","items":{"type":"string","pattern":"^[A-Z]{3}(?:-[A-Z0-9]+)+-[0-9]{3}$"}}}}},"result_ids":{"type":"array","items":{"type":"string","pattern":"^[A-Z]{3}(?:-[A-Z0-9]+)+-[0-9]{3}$"}},"notes":{"type":"string"}}}},
    "assessment":{"type":"string","minLength":1},"reproducibility_status":{"type":"string","enum":["not_assessed","reproduced","partially_reproduced","not_reproduced","inconclusive"]},"match_rate":{"type":"number","minimum":0,"maximum":1},"deviations":{"type":"array","items":{"type":"string"}},"limitations":{"type":"array","items":{"type":"string"}},"alternative_explanations":{"type":"array","items":{"type":"string"}},"result_ids":{"type":"array","items":{"type":"string","pattern":"^[A-Z]{3}(?:-[A-Z0-9]+)+-[0-9]{3}$"}},"outcome_ids":{"type":"array","items":{"type":"string","pattern":"^[A-Z]{3}(?:-[A-Z0-9]+)+-[0-9]{3}$"}},"provenance_ids":{"type":"array","items":{"type":"string","pattern":"^PRV-[A-Z0-9-]+-[0-9]{3}$"}},"epistemic_firewall":{"type":"string","minLength":1},"notes":{"type":"string"}
  }
}
