{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/jawa-dam/GEI-Research/blob/main/schema/attestation.schema.json",
  "title":"GEI Research Integrity Attestation",
  "type":"object","additionalProperties":false,
  "required":["id","type","title","status","version","attestation_status","record_ids","baseline_provenance_id","digest_algorithm","digest_scope","expected_digests","observed_digests","drifted_record_ids","checked_at","actor","epistemic_firewall"],
  "properties":{
    "id":{"type":"string","pattern":"^ATT-[A-Z0-9-]+-[0-9]{3}$"},"type":{"const":"attestation"},"title":{"type":"string","minLength":1},"status":{"type":"string","enum":["draft","active","deprecated"]},"version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},"attestation_status":{"type":"string","enum":["pass","warn","drift","fail"]},"record_ids":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^[A-Z]{3}(?:-[A-Z0-9]+)+-[0-9]{3}$"}},"baseline_provenance_id":{"type":"string","pattern":"^PRV-[A-Z0-9-]+-[0-9]{3}$"},"digest_algorithm":{"const":"SHA-256"},"digest_scope":{"const":"canonical_json"},
    "expected_digests":{"type":"object","minProperties":1,"additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"observed_digests":{"type":"object","minProperties":1,"additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"drifted_record_ids":{"type":"array","items":{"type":"string","pattern":"^[A-Z]{3}(?:-[A-Z0-9]+)+-[0-9]{3}$"}},"checked_at":{"type":"string","format":"date-time"},"actor":{"type":"string","minLength":1},"commit_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"epistemic_firewall":{"type":"string","minLength":1},"notes":{"type":"string"}
  }
}