{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/jawa-dam/GEI-Research/blob/main/schema/decision.schema.json","title":"GEI Research Decision Record","type":"object","additionalProperties":false,"required":["id","type","title","status","version","decision_status","question_ids","rationale","decision_type"],"properties":{"id":{"type":"string","pattern":"^DEC-[A-Z0-9-]+-[0-9]{3}$"},"type":{"const":"decision"},"title":{"type":"string","minLength":1},"status":{"type":"string","enum":["draft","active","deprecated","closed"]},"version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},"decision_status":{"type":"string","enum":["proposed","approved","executing","executed","rejected","revised"]},"decision_type":{"type":"string","enum":["research_direction","test_design","interpretive_choice","data_collection","comparison","publication","revision"]},"question_ids":{"type":"array","items":{"type":"string","pattern":"^QST-[A-Z0-9-]+-[0-9]{3}$"}},"investigation_ids":{"type":"array","items":{"type":"string","pattern":"^INV-[A-Z0-9-]+-[0-9]{3}$"}},"claim_ids":{"type":"array","items":{"type":"string","pattern":"^CLM-[A-Z0-9-]+-[0-9]{3}$"}},"hypothesis_ids":{"type":"array","items":{"type":"string","pattern":"^HYP-[A-Z0-9-]+-[0-9]{3}$"}},"rationale":{"type":"string","minLength":1},"alternatives_considered":{"type":"array","items":{"type":"string"}},"selected_action":{"type":"string"},"rejection_reason":{"type":"string"},"confidence":{"type":"string","enum":["C0","C1","C2","C3","C4","C5"]},"notes":{"type":"string"}}}