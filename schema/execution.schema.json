{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/jawa-dam/GEI-Research/blob/main/schema/execution.schema.json","title":"GEI Research Execution Record","type":"object","additionalProperties":false,"required":["id","type","title","status","version","execution_status","decision_ids","action","observations"],"properties":{"id":{"type":"string","pattern":"^EXE-[A-Z0-9-]+-[0-9]{3}$"},"type":{"const":"execution"},"title":{"type":"string","minLength":1},"status":{"type":"string","enum":["draft","active","deprecated","closed"]},"version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},"execution_status":{"type":"string","enum":["planned","running","completed","blocked","aborted","repeated"]},"decision_ids":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^DEC-[A-Z0-9-]+-[0-9]{3}$"}},"investigation_ids":{"type":"array","items":{"type":"string","pattern":"^INV-[A-Z0-9-]+-[0-9]{3}$"}},"action":{"type":"string","minLength":1},"protocol":{"type":"array","items":{"type":"string"}},"observations":{"type":"array","items":{"type":"string"}},"evidence_ids":{"type":"array","items":{"type":"string","pattern":"^EVD-[A-Z0-9-]+-[0-9]{3}$"}},"result_ids":{"type":"array","items":{"type":"string","pattern":"^RES-[A-Z0-9-]+-[0-9]{3}$"}},"deviations":{"type":"array","items":{"type":"string"}},"notes":{"type":"string"}}}