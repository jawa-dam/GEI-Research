{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/jawa-dam/GEI-Research/blob/main/schema/investigation.schema.json","title":"GEI Research Investigation Record","type":"object","additionalProperties":false,"required":["id","type","title","status","version","investigation_status","question_ids"],"properties":{"id":{"type":"string","pattern":"^INV-[A-Z0-9-]+-[0-9]{3}$"},"type":{"const":"investigation"},"title":{"type":"string","minLength":1},"status":{"type":"string","enum":["draft","active","deprecated","closed"]},"version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},"investigation_status":{"type":"string","enum":["planned","in_progress","tested","revised","closed","inconclusive"]},"question_ids":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^QST-[A-Z0-9-]+-[0-9]{3}$"}},"claim_ids":{"type":"array","items":{"type":"string","pattern":"^CLM-[A-Z0-9-]+-[0-9]{3}$"}},"source_ids":{"type":"array","items":{"type":"string","pattern":"^SRC-[A-Z0-9-]+-[0-9]{3}$"}},"evidence_ids":{"type":"array","items":{"type":"string","pattern":"^EVD-[A-Z0-9-]+-[0-9]{3}$"}},"comparison_ids":{"type":"array","items":{"type":"string","pattern":"^CMP-[A-Z0-9-]+-[0-9]{3}$"}},"interpretation_ids":{"type":"array","items":{"type":"string","pattern":"^INT-[A-Z0-9-]+-[0-9]{3}$"}},"hypothesis_ids":{"type":"array","items":{"type":"string","pattern":"^HYP-[A-Z0-9-]+-[0-9]{3}$"}},"counterevidence_ids":{"type":"array","items":{"type":"string","pattern":"^EVD-[A-Z0-9-]+-[0-9]{3}$"}},"alternative_explanation":{"type":"string"},"test_plan":{"type":"array","items":{"type":"string"}},"result_ids":{"type":"array","items":{"type":"string","pattern":"^RES-[A-Z0-9-]+-[0-9]{3}$"}},"outcome_ids":{"type":"array","items":{"type":"string","pattern":"^OUT-[A-Z0-9-]+-[0-9]{3}$"}},"notes":{"type":"string"}}}