{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/jawa-dam/GEI-Research/blob/main/schema/result.schema.json","title":"GEI Research Result Record","type":"object","additionalProperties":false,"required":["id","type","title","status","version","result_status","result","investigation_ids"],"properties":{"id":{"type":"string","pattern":"^RES-[A-Z0-9-]+-[0-9]{3}$"},"type":{"const":"result"},"title":{"type":"string","minLength":1},"status":{"type":"string","enum":["draft","active","deprecated","final"]},"version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},"result_status":{"type":"string","enum":["preliminary","supported","challenged","revised","inconclusive","rejected"]},"result":{"type":"string","minLength":1},"investigation_ids":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^INV-[A-Z0-9-]+-[0-9]{3}$"}},"evidence_ids":{"type":"array","items":{"type":"string","pattern":"^EVD-[A-Z0-9-]+-[0-9]{3}$"}},"counterevidence_ids":{"type":"array","items":{"type":"string","pattern":"^EVD-[A-Z0-9-]+-[0-9]{3}$"}},"confidence":{"type":"string","enum":["C0","C1","C2","C3","C4","C5"]},"notes":{"type":"string"}}}