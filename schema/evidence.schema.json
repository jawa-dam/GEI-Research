{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/jawa-dam/GEI-Research/blob/main/schema/evidence.schema.json","title":"GEI Evidence Record","type":"object","additionalProperties":false,"required":["id","type","title","status","version","evidence_level","claim_status"],"properties":{"id":{"type":"string","pattern":"^EVD-[A-Z0-9-]+$"},"type":{"const":"evidence"},"title":{"type":"string","minLength":1},"status":{"type":"string","enum":["draft","active","deprecated"]},"version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},"evidence_level":{"type":"string","enum":["E1","E2","E3","E4","E5"]},"claim_status":{"type":"string","enum":["supports","challenges","neutral","uncertain"]},"statement":{"type":"string"},"observation":{"type":"string"},"source_ids":{"type":"array","items":{"type":"string","pattern":"^SRC-[A-Z0-9-]+$"}},"passage_ids":{"type":"array","items":{"type":"string","pattern":"^PAS-[A-Z0-9-]+$"}},"comparison_ids":{"type":"array","items":{"type":"string","pattern":"^CMP-[A-Z0-9-]+$"}},"confidence":{"type":"string","enum":["C0","C1","C2","C3","C4","C5"]},"counterevidence_ids":{"type":"array","items":{"type":"string","pattern":"^EVD-[A-Z0-9-]+$"}},"notes":{"type":"string"}}}