{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/jawa-dam/GEI-Research/blob/main/schema/claim.schema.json","title":"GEI Claim Record","type":"object","additionalProperties":false,"required":["id","type","title","status","version","claim"],"properties":{"id":{"type":"string","pattern":"^CLM-[A-Z0-9-]+-[0-9]{3}$"},"type":{"const":"claim"},"title":{"type":"string","minLength":1},"status":{"type":"string","enum":["draft","active","deprecated","rejected"]},"version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},"claim":{"type":"string","minLength":1},"question_ids":{"type":"array","items":{"type":"string","pattern":"^QST-[A-Z0-9-]+-[0-9]{3}$"}},"source_ids":{"type":"array","items":{"type":"string","pattern":"^SRC-[A-Z0-9-]+-[0-9]{3}$"}},"evidence_ids":{"type":"array","items":{"type":"string","pattern":"^EVD-[A-Z0-9-]+-[0-9]{3}$"}},"comparison_ids":{"type":"array","items":{"type":"string","pattern":"^CMP-[A-Z0-9-]+-[0-9]{3}$"}},"interpretation_ids":{"type":"array","items":{"type":"string","pattern":"^INT-[A-Z0-9-]+-[0-9]{3}$"}},"counterevidence_ids":{"type":"array","items":{"type":"string","pattern":"^EVD-[A-Z0-9-]+-[0-9]{3}$"}},"confidence":{"type":"string","enum":["C0","C1","C2","C3","C4","C5"]},"notes":{"type":"string"}}}