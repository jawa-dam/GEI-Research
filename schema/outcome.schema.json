{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/jawa-dam/GEI-Research/blob/main/schema/outcome.schema.json","title":"GEI Research Outcome Record","type":"object","additionalProperties":false,"required":["id","type","title","status","version","outcome","investigation_ids"],"properties":{"id":{"type":"string","pattern":"^OUT-[A-Z0-9-]+-[0-9]{3}$"},"type":{"const":"outcome"},"title":{"type":"string","minLength":1},"status":{"type":"string","enum":["draft","active","deprecated","final"]},"version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},"outcome":{"type":"string","minLength":1},"investigation_ids":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^INV-[A-Z0-9-]+-[0-9]{3}$"}},"result_ids":{"type":"array","items":{"type":"string","pattern":"^RES-[A-Z0-9-]+-[0-9]{3}$"}},"disposition":{"type":"string","enum":["supports","partially_supports","does_not_support","inconclusive","requires_further_testing"]},"next_steps":{"type":"array","items":{"type":"string"}},"confidence":{"type":"string","enum":["C0","C1","C2","C3","C4","C5"]},"notes":{"type":"string"}}}