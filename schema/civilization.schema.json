{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/jawa-dam/GEI-Research/blob/main/schema/civilization.schema.json","title":"GEI Civilization Record","type":"object","additionalProperties":false,"required":["id","type","title","status","version"],"properties":{"id":{"type":"string","pattern":"^CIV-[A-Z0-9-]+$"},"type":{"const":"civilization"},"title":{"type":"string","minLength":1},"status":{"type":"string","enum":["draft","active","deprecated"]},"version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},"description":{"type":"string"},"date_range":{"type":"string"},"region_ids":{"type":"array","items":{"type":"string","pattern":"^REG-[A-Z0-9-]+$"}},"chronology_ids":{"type":"array","items":{"type":"string","pattern":"^CHR-[A-Z0-9-]+$"}},"source_ids":{"type":"array","items":{"type":"string","pattern":"^SRC-[A-Z0-9-]+$"}},"notes":{"type":"string"}}}