{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/jawa-dam/GEI-Research/blob/main/schema/protocol.schema.json",
  "title":"GEI Research Reproducibility Protocol",
  "type":"object","additionalProperties":false,
  "required":["id","type","title","status","version","question_ids","investigation_ids","objective","protocol_steps","inputs","outputs","reproducibility_criteria","epistemic_firewall"],
  "properties":{
    "id":{"type":"string","pattern":"^PRO-[A-Z0-9-]+-[0-9]{3}$"},"type":{"const":"protocol"},"title":{"type":"string","minLength":1},"status":{"type":"string","enum":["draft","active","deprecated"]},"version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
    "question_ids":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^[A-Z]{3}(?:-[A-Z0-9]+)+-[0-9]{3}$"}},"investigation_ids":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^[A-Z]{3}(?:-[A-Z0-9]+)+-[0-9]{3}$"}},"objective":{"type":"string","minLength":1},
    "protocol_steps":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["step_id","order","action","expected_observation"],"properties":{"step_id":{"type":"string","pattern":"^STEP-[A-Z0-9-]+-[0-9]{3}$"},"order":{"type":"integer","minimum":1},"action":{"type":"string","minLength":1},"expected_observation":{"type":"string","minLength":1},"acceptance_rule":{"type":"string"},"notes":{"type":"string"}}}},
    "inputs":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["input_id","description","source_ids"],"properties":{"input_id":{"type":"string","pattern":"^IN-[A-Z0-9-]+-[0-9]{3}$"},"description":{"type":"string"},"source_ids":{"type":"array","items":{"type":"string","pattern":"^[A-Z]{3}(?:-[A-Z0-9]+)+-[0-9]{3}$"}},"required":{"type":"boolean"}}}},
    "outputs":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["output_id","description"],"properties":{"output_id":{"type":"string","pattern":"^OUTP-[A-Z0-9-]+-[0-9]{3}$"},"description":{"type":"string"},"record_type":{"type":"string"}}}},
    "reproducibility_criteria":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["criterion_id","name","rule"],"properties":{"criterion_id":{"type":"string","pattern":"^CRIT-[A-Z0-9-]+-[0-9]{3}$"},"name":{"type":"string"},"rule":{"type":"string"},"threshold":{"type":"string"}}}},
    "controls":{"type":"array","items":{"type":"string"}},"alternative_explanations":{"type":"array","items":{"type":"string"}},"epistemic_firewall":{"type":"string","minLength":1},"provenance_ids":{"type":"array","items":{"type":"string","pattern":"^PRV-[A-Z0-9-]+-[0-9]{3}$"}},"notes":{"type":"string"}
  }
}
