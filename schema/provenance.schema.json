{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/jawa-dam/GEI-Research/blob/main/schema/provenance.schema.json",
  "title":"GEI Research Provenance Record",
  "type":"object",
  "additionalProperties":false,
  "required":["id","type","title","status","version","event_type","record_ids","reason","actor","timestamp","verification_status"],
  "properties":{
    "id":{"type":"string","pattern":"^PRV-[A-Z0-9-]+-[0-9]{3}$"},"type":{"const":"provenance"},"title":{"type":"string","minLength":1},"status":{"type":"string","enum":["draft","active","deprecated"]},"version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},"event_type":{"type":"string","enum":["created","updated","revised","verified","deprecated","restored"]},
    "record_ids":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^[A-Z]{3}(?:-[A-Z0-9]+)+-[0-9]{3}$"}},"previous_versions":{"type":"array","items":{"type":"string"}},"new_versions":{"type":"array","items":{"type":"string"}},"reason":{"type":"string","minLength":1},"actor":{"type":"string","minLength":1},"timestamp":{"type":"string","format":"date-time"},
    "source_ids":{"type":"array","items":{"type":"string","pattern":"^SRC-[A-Z0-9-]+$"}},"evidence_ids":{"type":"array","items":{"type":"string","pattern":"^EVD-[A-Z0-9-]+$"}},"decision_ids":{"type":"array","items":{"type":"string","pattern":"^DEC-[A-Z0-9-]+-[0-9]{3}$"}},"commit_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"verification_status":{"type":"string","enum":["unverified","verified","disputed"]},"integrity_notes":{"type":"string"},
    "digest_algorithm":{"const":"SHA-256"},"digest_scope":{"const":"canonical_json"},"record_digests":{"type":"object","minProperties":1,"additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
  }
}