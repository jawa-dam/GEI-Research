{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/jawa-dam/GEI-Research/blob/main/schema/replication.schema.json",
  "title":"GEI Research Independent Replication & Cross-Operator Verification Record",
  "type":"object","additionalProperties":false,
  "required":["id","type","title","status","version","protocol_id","baseline_reproducibility_id","operators","replication_runs","comparison","replication_status","epistemic_firewall"],
  "properties":{
    "id":{"type":"string","pattern":"^RPL-[A-Z0-9-]+-[0-9]{3}$"},"type":{"const":"replication"},"title":{"type":"string","minLength":1},"status":{"type":"string","enum":["draft","active","deprecated"]},"version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
    "protocol_id":{"type":"string","pattern":"^PRO-[A-Z0-9-]+-[0-9]{3}$"},"baseline_reproducibility_id":{"type":"string","pattern":"^REP-[A-Z0-9-]+-[0-9]{3}$"},
    "operators":{"type":"array","minItems":2,"items":{"type":"object","additionalProperties":false,"required":["operator_id","role","independent","status"],"properties":{"operator_id":{"type":"string","pattern":"^OP-[A-Z0-9-]+-[0-9]{3}$"},"role":{"type":"string"},"independent":{"type":"boolean"},"status":{"type":"string","enum":["planned","active","completed","withdrawn"]},"notes":{"type":"string"}}}},
    "replication_runs":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["run_id","operator_id","protocol_version","status","step_results"],"properties":{"run_id":{"type":"string","pattern":"^RNR-[A-Z0-9-]+-[0-9]{3}$"},"operator_id":{"type":"string","pattern":"^OP-[A-Z0-9-]+-[0-9]{3}$"},"protocol_version":{"type":"string"},"status":{"type":"string","enum":["planned","executed","completed","failed","inconclusive"]},"step_results":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["step_id","status","observed"],"properties":{"step_id":{"type":"string"},"status":{"type":"string","enum":["pass","fail","not_run"]},"observed":{"type":"string"},"deviation":{"type":"string"},"evidence_ids":{"type":"array","items":{"type":"string","pattern":"^[A-Z]{3}(?:-[A-Z0-9]+)+-[0-9]{3}$"}}}}},"blind_to_baseline":{"type":"boolean"},"notes":{"type":"string"}}}},
    "comparison":{"type":"object","additionalProperties":false,"required":["comparison_status","compared_runs","agreement_metrics","disagreements","resolution_method"],"properties":{"comparison_status":{"type":"string","enum":["not_started","in_progress","complete","inconclusive"]},"compared_runs":{"type":"array","items":{"type":"string","pattern":"^RNR-[A-Z0-9-]+-[0-9]{3}$"}},"agreement_metrics":{"type":"object","additionalProperties":{"type":"number","minimum":0,"maximum":1}},"disagreements":{"type":"array","items":{"type":"string"}},"resolution_method":{"type":"string"},"blind_comparison":{"type":"boolean"},"notes":{"type":"string"}}},
    "replication_status":{"type":"string","enum":["not_assessed","pending_independent_runs","replicated","partially_replicated","not_replicated","inconclusive"]},"replication_score":{"type":"number","minimum":0,"maximum":1},"deviations":{"type":"array","items":{"type":"string"}},"limitations":{"type":"array","items":{"type":"string"}},"result_ids":{"type":"array","items":{"type":"string","pattern":"^[A-Z]{3}(?:-[A-Z0-9]+)+-[0-9]{3}$"}},"outcome_ids":{"type":"array","items":{"type":"string","pattern":"^[A-Z]{3}(?:-[A-Z0-9]+)+-[0-9]{3}$"}},"provenance_ids":{"type":"array","items":{"type":"string","pattern":"^PRV-[A-Z0-9-]+-[0-9]{3}$"}},
    "epistemic_firewall":{"type":"string","minLength":1},"notes":{"type":"string"}
  }
}
