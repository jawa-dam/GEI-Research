{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/jawa-dam/GEI-Research/blob/main/schema/technology.schema.json","title":"GEI Technology Record","type":"object","additionalProperties":false,"required":["id","type","title","status","version"],"properties":{"id":{"type":"string","pattern":"^TEC-[A-Z0-9-]+$"},"type":{"const":"technology"},"title":{"type":"string","minLength":1},"status":{"type":"string","enum":["draft","active","deprecated"]},"version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},"description":{"type":"string"},"technology_category":{"type":"string"},"functions":{"type":"array","items":{"type":"string"}},"materials":{"type":"array","items":{"type":"string"}},"date_range":{"type":"string"},"civilization_ids":{"type":"array","items":{"type":"string","pattern":"^CIV-[A-Z0-9-]+$"}},"region_ids":{"type":"array","items":{"type":"string","pattern":"^REG-[A-Z0-9-]+$"}},"water_ids":{"type":"array","items":{"type":"string","pattern":"^WTR-[A-Z0-9-]+$"}},"source_ids":{"type":"array","items":{"type":"string","pattern":"^SRC-[A-Z0-9-]+$"}},"evidence_ids":{"type":"array","items":{"type":"string","pattern":"^EVD-[A-Z0-9-]+$"}},"notes":{"type":"string"}}}